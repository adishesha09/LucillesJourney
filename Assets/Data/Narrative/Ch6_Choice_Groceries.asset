  m_Script: {fileID: 11500000, guid: e11eb966926430645a74f277282b07be, type: 3}
  m_Name: Ch6_Choice_Groceries
  m_EditorClassIdentifier: Assembly-CSharp::LucillesJourney.Narrative.NarrativeSequenceSO
  sequenceName: Ch6_Choice_Groceries
  lines:
  - speakerName: Narrator
    text: Nobody goes hungry this week. The electricity is cut two days later, and
      the school letter arrives the day after that.
  - speakerName: Lucille
    text: They need to eat today. Tomorrow's problems can wait until tomorrow.
