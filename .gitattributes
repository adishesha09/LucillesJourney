# Unity text-based assets: normalise line endings, keep diffs sane
*.cs text eol=lf diff=csharp
*.shader text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.md text eol=lf
*.meta text eol=lf
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge
*.mat text eol=lf merge=unityyamlmerge
*.inputactions text eol=lf

# Binary assets
*.png binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
